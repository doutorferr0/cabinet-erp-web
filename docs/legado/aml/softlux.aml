rel Clientes(Ind_codigo) -> Indicacoes(Ind_codigo) # inferida (nome)
rel Clientes(COD_ATIVID) -> "Profissão"(COD_ATIVID) # inferida (nome)
rel fornecedor(ban_codigo) -> Bancos(Ban_Codigo) # inferida (nome)
rel Funcionario(COD_ATIVID) -> "Profissão"(COD_ATIVID) # inferida (nome)

