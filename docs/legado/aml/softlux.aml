rel Tributacao(SysPaises_codigo) -> SysPaises(SysPaises_codigo)
rel Custo(for_codigo) -> fornecedor(For_codigo) # inferida (nome)
rel custo_log(for_codigo) -> fornecedor(For_codigo) # inferida (nome)
rel Indice_preco(for_codigo) -> fornecedor(For_codigo) # inferida (nome)
rel Indice_preco_log(csl_codigo) -> custo_log(Csl_codigo) # inferida (nome)
rel Indice_preco_log(for_codigo) -> fornecedor(For_codigo) # inferida (nome)
rel Indice_precoGrupoUsuario(for_codigo) -> fornecedor(For_codigo) # inferida (nome)
rel Indice_precoGrupoUsuario(Cod_grupo) -> SisGrupo_Usuario(Cod_grupo) # inferida (nome)
rel Preco_Produto(Pre_Codnosso) -> produtos(Pro_codnosso) # inferida (sinonimo)
rel Preco_Produto(Pre_Acabamento) -> Acabamento(CodAcabamento) # inferida (sinonimo)
rel Preco_Produto(Pre_Fornecedor) -> fornecedor(For_codigo) # inferida (sinonimo)
rel produtos(For_codigo) -> fornecedor(For_codigo) # inferida (nome)
rel produtos(GrupoProduto_codigo) -> GrupoProduto(GrupoProduto_Codigo) # inferida (nome)
rel produtos(Trib_Codigo) -> Tributacao(Trib_Codigo) # inferida (nome)
rel produtos(COFINS_codigo) -> TipoCOFINS(COFINS_codigo) # inferida (nome)
rel produtos(PIS_codigo) -> TipoPIS(PIS_codigo) # inferida (nome)
rel produtos(IPI_codigo) -> TipoIPI(IPI_codigo) # inferida (nome)
rel produtos(TbImp_codigo) -> TabelaImposto(TbImp_codigo) # inferida (nome)
rel produtos(ClasProd_codigo) -> ClassificacaoProduto(ClasProd_codigo) # inferida (nome)
rel ProdutosFornecedores(Pro_codnosso) -> produtos(Pro_codnosso) # inferida (nome)
rel ProdutosRelacionadosCadProdutos(Pro_codnosso) -> produtos(Pro_codnosso) # inferida (nome)
rel ProdutosRelacionadosDet(ProdRel_codigo) -> ProdutosRelacionados(ProdRel_codigo) # inferida (nome)
rel ProdutosRelacionadosDet(Pro_codnosso) -> produtos(Pro_codnosso) # inferida (nome)
rel ProdutosRelacionadosDet(CodAcabamento) -> Acabamento(CodAcabamento) # inferida (nome)

