// ---------- relacoes DECLARADAS no banco ----------
Ref: Nota_entrada.Mod_codigo > Motivo_devolucao.Mod_codigo
Ref: Nota_entrada.nen_Mod_codigo_fin > Motivo_devolucao.Mod_codigo
Ref: produtos.TpOriPro_codigo > TipoOrigemProduto.TpOriPro_codigo
Ref: produtos.TpTrib_codigo > TipoTributadaICMS.TpTrib_codigo

// ---------- relacoes INFERIDAS, nao declaradas pelo legado ----------
// nome: mesma coluna, mesmo tipo, e a coluna e PK simples do destino.
// sinonimo: prefixo diferente para a MESMA coisa (Pro_codnosso = Epr_Codnosso).
// CONFERIR antes de tratar como verdade.
Ref: Nota_entrada.Pco_codigo > Plano_Contas.Pco_codigo // inferida (nome)
Ref: nota_entrada_det.Nen_codigo > Nota_entrada.Nen_codigo // inferida (nome)
Ref: nota_entrada_det.Pro_codnosso > produtos.Pro_codnosso // inferida (nome)
Ref: nota_entrada_det.CFOP_codigo > CFOP.CFOP_codigo // inferida (nome)
Ref: nota_entrada_det.TpTrib_codigo > TipoTributadaICMS.TpTrib_codigo // inferida (nome)
Ref: nota_entrada_det.TpOriPro_codigo > TipoOrigemProduto.TpOriPro_codigo // inferida (nome)
Ref: nota_entrada_det.PIS_codigo > TipoPIS.PIS_codigo // inferida (nome)
Ref: nota_entrada_det.COFINS_codigo > TipoCOFINS.COFINS_codigo // inferida (nome)
Ref: nota_entrada_det.IPI_codigo > TipoIPI.IPI_codigo // inferida (nome)
Ref: ordem_compra_det.Ocp_codigo > ordem_compra.Ocp_codigo // inferida (nome)
Ref: ordem_compra_det.Pro_codnosso > produtos.Pro_codnosso // inferida (nome)
Ref: pedido_compra.ParSV_serie > ParamentrosSerieVenda.ParSV_serie // inferida (nome)
Ref: Pedido_compra_det.Pcp_codigo > pedido_compra.Pcp_codigo // inferida (nome)
Ref: Pedido_compra_det.Pro_codnosso > produtos.Pro_codnosso // inferida (nome)
Ref: produtos.COFINS_codigo > TipoCOFINS.COFINS_codigo // inferida (nome)
Ref: produtos.PIS_codigo > TipoPIS.PIS_codigo // inferida (nome)
Ref: produtos.IPI_codigo > TipoIPI.IPI_codigo // inferida (nome)
