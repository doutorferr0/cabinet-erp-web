// ---------- relacoes DECLARADAS no banco ----------
Ref: BalancoEstoqueProdutos.BalEst_Codigo > BalancoEstoque.BalEst_Codigo
Ref: RequisicaoEstoqProd.ReqEst_Codigo > RequisicaoEstoq.ReqEst_Codigo
Ref: TransferenciaEstoque.Mod_codigo > Motivo_devolucao.Mod_codigo
Ref: Venda.ParSV_serie > ParamentrosSerieVenda.ParSV_serie

// ---------- relacoes INFERIDAS, nao declaradas pelo legado ----------
// nome: mesma coluna, mesmo tipo, e a coluna e PK simples do destino.
// sinonimo: prefixo diferente para a MESMA coisa (Pro_codnosso = Epr_Codnosso).
// CONFERIR antes de tratar como verdade.
Ref: BalancoEstoqueProdutos.Pro_Codnosso > produtos.Pro_codnosso // inferida (nome)
Ref: BalancoEstoqueProdutos.CodAcabamento > Acabamento.CodAcabamento // inferida (nome)
Ref: estoque_log.EstTp_Codigo > EstoqueTipo.EstTp_Codigo // inferida (nome)
Ref: estoque_log.ParSV_serie > ParamentrosSerieVenda.ParSV_serie // inferida (nome)
Ref: Estoque_produto.Epr_Codnosso > produtos.Pro_codnosso // inferida (sinonimo)
Ref: Estoque_produto.Epr_Acabamento > Acabamento.CodAcabamento // inferida (sinonimo)
Ref: Estoque_produto.EstTp_Codigo > EstoqueTipo.EstTp_Codigo // inferida (nome)
Ref: estoque_produto_dia.EstTp_Codigo > EstoqueTipo.EstTp_Codigo // inferida (nome)
Ref: produtos.For_codigo > fornecedor.For_codigo // inferida (nome)
Ref: RequisicaoEstoq.ParSV_serie > ParamentrosSerieVenda.ParSV_serie // inferida (nome)
Ref: RequisicaoEstoqProd.Pro_codnosso > produtos.Pro_codnosso // inferida (nome)
Ref: RequisicaoEstoqProd.CodAcabamento > Acabamento.CodAcabamento // inferida (nome)
Ref: RequisicaoEstoqProd.CodAmbiente > Ambiente.CodAmbiente // inferida (nome)
Ref: TransferenciaEstoque.For_codigo > fornecedor.For_codigo // inferida (nome)
Ref: TransferenciaEstoque.Ven_CodigoPre > Venda.Ven_CodigoPre // inferida (nome)
Ref: TransferenciaEstoqueProduto.TransfEst_codigo > TransferenciaEstoque.TransfEst_codigo // inferida (nome)
Ref: TransferenciaEstoqueProduto.Pro_codnosso > produtos.Pro_codnosso // inferida (nome)
Ref: TransferenciaEstoqueProduto.CodAcabamento > Acabamento.CodAcabamento // inferida (nome)
Ref: Venda.Mod_codigo > Motivo_devolucao.Mod_codigo // inferida (nome)
