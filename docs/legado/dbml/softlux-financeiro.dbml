// ---------- relacoes DECLARADAS no banco ----------
Ref: Bancos_Caixas.Ban_codigo > Bancos.Ban_Codigo
Ref: Bancos_Caixas.mun_codigo > Municipio.mun_codigo
Ref: contas_apagar.Cdc_codigo > Centro_de_custo.Cdc_codigo
Ref: contas_apagar.Pco_codigo > Plano_Contas.Pco_codigo
Ref: contas_apagar.Tcf_codigo > TipoContaFinanceira.Tcf_codigo
Ref: Contas_Bancarias.Bcx_codigo > Bancos_Caixas.Bcx_codigo
Ref: Contas_Bancarias.Emp_codigo > Bancos_Caixas.Emp_codigo
Ref: contas_receber.Cdc_codigo > Centro_de_custo.Cdc_codigo
Ref: contas_receber.Pco_codigo > Plano_Contas.Pco_codigo
Ref: contas_receber.Tcf_codigo > TipoContaFinanceira.Tcf_codigo
Ref: CreditoIndicacao.Ind_Codigo > Indicacoes.Ind_codigo
Ref: CreditoIndicacao.Tpd_codigo > Tipo_documento.Tpd_codigo

// ---------- relacoes INFERIDAS, nao declaradas pelo legado ----------
// nome: mesma coluna, mesmo tipo, e a coluna e PK simples do destino.
// sinonimo: prefixo diferente para a MESMA coisa (Pro_codnosso = Epr_Codnosso).
// CONFERIR antes de tratar como verdade.
Ref: contas_apagar.Tpd_codigo > Tipo_documento.Tpd_codigo // inferida (nome)
Ref: contas_apagar.ParSV_serie > ParamentrosSerieVenda.ParSV_serie // inferida (nome)
Ref: contas_apagar_det.Ctp_codigo > contas_apagar.Ctp_codigo // inferida (nome)
Ref: contas_apagar_det.Mdo_codigo > Modo.Mdo_codigo // inferida (nome)
Ref: Contas_apagar_pag.mdo_codigo > Modo.Mdo_codigo // inferida (nome)
Ref: Contas_apagar_pag.cba_codigo > FechamentoContas.Cba_codigo // inferida (nome)
Ref: Contas_apagar_pag.Mod_codigo > Motivo_devolucao.Mod_codigo // inferida (nome)
Ref: Contas_Bancarias.Cba_codigo > FechamentoContas.Cba_codigo // inferida (nome)
Ref: Contas_BancariasCobranca.Cba_codigo > FechamentoContas.Cba_codigo // inferida (nome)
Ref: contas_receber.Tpd_codigo > Tipo_documento.Tpd_codigo // inferida (nome)
Ref: contas_receber.ParSV_serie > ParamentrosSerieVenda.ParSV_serie // inferida (nome)
Ref: contas_Receber_det.Ctr_codigo > contas_receber.Ctr_codigo // inferida (nome)
Ref: contas_Receber_det.Mdo_codigo > Modo.Mdo_codigo // inferida (nome)
Ref: Contas_receber_pag.Ctr_codigo > contas_receber.Ctr_codigo // inferida (nome)
Ref: Contas_receber_pag.Mdo_codigo > Modo.Mdo_codigo // inferida (nome)
Ref: Contas_receber_pag.cba_codigo > FechamentoContas.Cba_codigo // inferida (nome)
Ref: Contas_receber_pag.Mod_codigo > Motivo_devolucao.Mod_codigo // inferida (nome)
Ref: Credito.Tpd_Codigo > Tipo_documento.Tpd_codigo // inferida (nome)
Ref: Credito.ParSV_serie > ParamentrosSerieVenda.ParSV_serie // inferida (nome)
Ref: CreditoIndicacao.Pco_codigo > Plano_Contas.Pco_codigo // inferida (nome)
Ref: CreditoIndicacao.Cdc_codigo > Centro_de_custo.Cdc_codigo // inferida (nome)
Ref: CreditoIndicacao.Ret_codigo > Reserva_tecnica.Ret_codigo // inferida (nome)
Ref: Plano_Contas.Pct_codigo > Plano_Contas_Tipo.Pct_codigo // inferida (nome)
Ref: Reserva_tecnica.ParSV_serie > ParamentrosSerieVenda.ParSV_serie // inferida (nome)
