// ---------- relacoes DECLARADAS no banco ----------
Ref: ProdutosFornecedores.For_codigo > fornecedor.For_codigo
Ref: Venda.CatVen_Codigo > CategoriaVenda.CatVen_Codigo
Ref: Venda.Obr_codigo > Obras.Obr_Codigo
Ref: VendaAmbiente.CodAmbiente > Ambiente.CodAmbiente
Ref: VendaDesconto.GrupoProduto_Codigo > GrupoProduto.GrupoProduto_Codigo
Ref: VendaDesconto.Ven_CodigoPre > Venda.Ven_CodigoPre
Ref: VendaIndicacao.Ind_Codigo > Indicacoes.Ind_codigo
Ref: VendaProduto.Pro_codnosso > produtos.Pro_codnosso
Ref: VendaProduto.Ven_CodigoPre > Venda.Ven_CodigoPre
Ref: VendaServico.CodAmbiente > Ambiente.CodAmbiente
Ref: VendaServico.Ven_codigopre > Venda.Ven_CodigoPre

// ---------- relacoes INFERIDAS, nao declaradas pelo legado ----------
// nome: mesma coluna, mesmo tipo, e a coluna e PK simples do destino.
// sinonimo: prefixo diferente para a MESMA coisa (Pro_codnosso = Epr_Codnosso).
// CONFERIR antes de tratar como verdade.
Ref: Clientes.Ind_codigo > Indicacoes.Ind_codigo // inferida (nome)
Ref: Custo.for_codigo > fornecedor.for_codigo // inferida (nome)
Ref: estoque_log.EstTp_Codigo > EstoqueTipo.EstTp_Codigo // inferida (nome)
Ref: Estoque_produto.Epr_Codnosso > produtos.Pro_codnosso // inferida (sinonimo)
Ref: Estoque_produto.Epr_Acabamento > Acabamento.CodAcabamento // inferida (sinonimo)
Ref: Estoque_produto.EstTp_Codigo > EstoqueTipo.EstTp_Codigo // inferida (nome)
Ref: Indice_preco.for_codigo > fornecedor.for_codigo // inferida (nome)
Ref: nota_entrada_det.Nen_codigo > Nota_entrada.Nen_codigo // inferida (nome)
Ref: nota_entrada_det.Pro_codnosso > produtos.Pro_codnosso // inferida (nome)
Ref: Obras.Cli_codigo > Clientes.Cli_codigo // inferida (nome)
Ref: ordem_compra_det.Ocp_codigo > ordem_compra.Ocp_codigo // inferida (nome)
Ref: ordem_compra_det.Pro_codnosso > produtos.Pro_codnosso // inferida (nome)
Ref: Pedido_compra_det.Pcp_codigo > pedido_compra.Pcp_codigo // inferida (nome)
Ref: Pedido_compra_det.Pro_codnosso > produtos.Pro_codnosso // inferida (nome)
Ref: Preco_Produto.Pre_Codnosso > produtos.Pro_codnosso // inferida (sinonimo)
Ref: Preco_Produto.Pre_Acabamento > Acabamento.CodAcabamento // inferida (sinonimo)
Ref: Preco_Produto.Pre_Fornecedor > fornecedor.For_codigo // inferida (sinonimo)
Ref: produtos.For_codigo > fornecedor.For_codigo // inferida (nome)
Ref: produtos.GrupoProduto_codigo > GrupoProduto.GrupoProduto_codigo // inferida (nome)
Ref: ProdutosFornecedores.Pro_codnosso > produtos.Pro_codnosso // inferida (nome)
Ref: Venda.Ind_codigo > Indicacoes.Ind_codigo // inferida (nome)
Ref: VendaProduto.CodAcabamento > Acabamento.CodAcabamento // inferida (nome)
Ref: VendaProduto.CodAmbiente > Ambiente.CodAmbiente // inferida (nome)
