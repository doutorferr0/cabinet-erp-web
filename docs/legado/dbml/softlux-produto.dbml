// ---------- relacoes DECLARADAS no banco ----------
Ref: produtos.TpOriPro_codigo > TipoOrigemProduto.TpOriPro_codigo
Ref: produtos.TpTrib_codigo > TipoTributadaICMS.TpTrib_codigo
Ref: ProdutosFornecedores.For_codigo > fornecedor.For_codigo
Ref: ProdutosRelacionadosCadProdutos.ProdRel_codigo > ProdutosRelacionados.ProdRel_codigo
Ref: Tributacao.SysPaises_codigo > SysPaises.SysPaises_codigo

// ---------- relacoes INFERIDAS, nao declaradas pelo legado ----------
// nome: mesma coluna, mesmo tipo, e a coluna e PK simples do destino.
// sinonimo: prefixo diferente para a MESMA coisa (Pro_codnosso = Epr_Codnosso).
// CONFERIR antes de tratar como verdade.
Ref: Custo.for_codigo > fornecedor.For_codigo // inferida (nome)
Ref: custo_log.for_codigo > fornecedor.For_codigo // inferida (nome)
Ref: Indice_preco.for_codigo > fornecedor.For_codigo // inferida (nome)
Ref: Indice_preco_log.csl_codigo > custo_log.Csl_codigo // inferida (nome)
Ref: Indice_preco_log.for_codigo > fornecedor.For_codigo // inferida (nome)
Ref: Indice_precoGrupoUsuario.for_codigo > fornecedor.For_codigo // inferida (nome)
Ref: Indice_precoGrupoUsuario.Cod_grupo > SisGrupo_Usuario.Cod_grupo // inferida (nome)
Ref: Preco_Produto.Pre_Codnosso > produtos.Pro_codnosso // inferida (sinonimo)
Ref: Preco_Produto.Pre_Acabamento > Acabamento.CodAcabamento // inferida (sinonimo)
Ref: Preco_Produto.Pre_Fornecedor > fornecedor.For_codigo // inferida (sinonimo)
Ref: produtos.For_codigo > fornecedor.For_codigo // inferida (nome)
Ref: produtos.GrupoProduto_codigo > GrupoProduto.GrupoProduto_Codigo // inferida (nome)
Ref: produtos.Trib_Codigo > Tributacao.Trib_Codigo // inferida (nome)
Ref: produtos.COFINS_codigo > TipoCOFINS.COFINS_codigo // inferida (nome)
Ref: produtos.PIS_codigo > TipoPIS.PIS_codigo // inferida (nome)
Ref: produtos.IPI_codigo > TipoIPI.IPI_codigo // inferida (nome)
Ref: produtos.TbImp_codigo > TabelaImposto.TbImp_codigo // inferida (nome)
Ref: produtos.ClasProd_codigo > ClassificacaoProduto.ClasProd_codigo // inferida (nome)
Ref: ProdutosFornecedores.Pro_codnosso > produtos.Pro_codnosso // inferida (nome)
Ref: ProdutosRelacionadosCadProdutos.Pro_codnosso > produtos.Pro_codnosso // inferida (nome)
Ref: ProdutosRelacionadosDet.ProdRel_codigo > ProdutosRelacionados.ProdRel_codigo // inferida (nome)
Ref: ProdutosRelacionadosDet.Pro_codnosso > produtos.Pro_codnosso // inferida (nome)
Ref: ProdutosRelacionadosDet.CodAcabamento > Acabamento.CodAcabamento // inferida (nome)
