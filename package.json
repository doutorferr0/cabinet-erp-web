{
  "name": "cabinet-erp-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check --write",
    "check-types": "tsc -b",
    "test": "vitest run",
    "par:semear": "node scripts/semear-par.mjs",
    "par:ao-vivo": "CABINET_AO_VIVO=1 vitest run src/mocks/ao-vivo.test.ts",
    "e2e": "playwright test",
    "codegen": "orval --config orval.config.ts && node scripts/pos-codegen.mjs",
    "contrato:delta": "node scripts/contrato-delta.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@svar-ui/react-gantt": "^2.7.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "motion": "13.1.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.7",
    "react-aria-components": "1.20.0",
    "react-dom": "^19.2.7",
